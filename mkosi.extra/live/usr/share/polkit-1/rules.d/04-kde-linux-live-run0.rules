// Ships in the live sysext, so it cannot reach an installed system. The live
// user has an empty password and could not be authenticated anyway.

polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
