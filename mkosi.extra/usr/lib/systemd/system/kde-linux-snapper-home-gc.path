# Nothing runs at userdel time, so catch the passwd write instead. The cleanup
# timer still covers homes that went away without passwd changing.

[Unit]
Description=Watch for Deleted Users
ConditionPathIsReadWrite=/etc
ConditionKernelCommandLine=!kde-linux.live=1

[Path]
PathChanged=/etc/passwd
Unit=kde-linux-snapper-home-gc.service

[Install]
WantedBy=multi-user.target
