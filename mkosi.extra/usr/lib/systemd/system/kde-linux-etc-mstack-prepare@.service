[Unit]
Description=etc-mstack-prepare hook
RefuseManualStart=yes

[Service]
Type=oneshot
ExecStart=etc-mstack-prepare
# the accepted varlink socket: one JSON-line call on stdin, reply on stdout
StandardInput=socket
StandardOutput=socket
StandardError=journal
