[Unit]
Description=Socket for etc-mstack-prepare hook

[Socket]
# systemd-sysupdate invokes io.systemd.SysUpdate.Notify.OnCompletedUpdate on
# every socket linked into this directory after a successful update
ListenStream=/run/systemd/sysupdate/notify/etc-mstack-prepare.socket
# one service instance per varlink connection, socket on stdin/stdout
Accept=yes
RuntimeDirectory=systemd/sysupdate/notify

[Install]
WantedBy=sockets.target
