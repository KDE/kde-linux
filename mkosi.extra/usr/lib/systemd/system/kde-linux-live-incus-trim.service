[Unit]
Description=Reclaim unused KDE Linux live Incus storage
Requires=kde-linux-live-incus-storage.service
After=kde-linux-live-incus-storage.service

[Service]
Type=oneshot
ExecStart=/usr/bin/fstrim /var/lib/incus
