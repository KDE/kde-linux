[Unit]
Description=Write the initial YAML history file for preinstalled Flatpaks
ConditionPathExists=!/var/lib/kde-linux/preinstalled-flatpak-history.yaml
ConditionKernelCommandLine=!kde-linux.live=1

# Sequencing considerations: we rely on the "legacy" version of the Flatpak list
# existing on old systems, so we run after the service that writes that. To
# detect fresh systems, we rely on the "plasma-setup-done" file *not* existing,
# so sequence before the Plasma setup service.
DefaultDependencies=no
After=local-fs.target kde-linux-seed-preinstalled-flatpak-list.service
Before=kde-linux-install-new-flatpak-apps.service plasma-setup.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/lib/seed-preinstalled-flatpak-history
