[Unit]
Description=Write the initial YAML history file for preinstalled Flatpaks
ConditionPathExists=!/var/lib/kde-linux/preinstalled-flatpak-history.yaml
ConditionKernelCommandLine=!kde-linux.live=1

# To detect fresh systems, we rely on the "plasma-setup-done" file *not* existing,
# so sequence before the Plasma setup service.
Before=kde-linux-install-new-flatpak-apps.service plasma-setup.service

[Service]
Type=oneshot
ExecStart=/usr/lib/seed-preinstalled-flatpak-history
