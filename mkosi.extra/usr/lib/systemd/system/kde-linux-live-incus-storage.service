[Unit]
Description=Prepare ephemeral Incus storage for the KDE Linux live session
DefaultDependencies=no
Requires=run-kde\x2dlinux\x2dincus.mount
After=local-fs.target run-kde\x2dlinux\x2dincus.mount
Before=sockets.target incus.service incus.socket incus-user.socket kapsule-daemon.service

[Service]
Type=oneshot
ExecStart=/usr/lib/kde-linux-live-incus-storage
RemainAfterExit=yes
