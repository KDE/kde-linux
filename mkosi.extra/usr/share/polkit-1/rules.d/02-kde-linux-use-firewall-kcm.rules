// Allow admin user to interact with the firewall KCM (open, enable, disable) without being
// prompted to authenticate.

polkit.addRule(function(action, subject) {
    if ((action.id == "org.kde.ufw.queryapps" || action.id == "org.kde.ufw.modify") && subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
