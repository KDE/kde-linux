# Hijack ninja to run the strip target instead of the default install target.

args=()
for arg in "$@"; do
    if [[ "$arg" == install ]]; then
        if [[ -e CMakeCache.txt ]]; then
            arg=install/strip
        elif [[ -d meson-info ]]; then
            # TODO support meson. It needs -Dstrip=true, but kde-builder cannot pass that through.
            # The target remains install and strips when configured with strip.
            # https://invent.kde.org/sdk/kde-builder/-/issues/121
            arg=install
        else
            printf 'Unknown build system; Cannot strip! -- %s -- %s\n' "$*" "$PWD" >&2
            exit 1
        fi
    fi
    args+=("$arg")
done

exec /usr/bin/ninja "${args[@]}"
